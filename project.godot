; Engine configuration file.
config_version=5

[application]
config/name="Mevzi"
config/description="İzometrik modern savaş RTS."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.08, 0.07, 0.06, 1)
boot_splash/show_image=false

[autoload]
G="*res://scripts/g.gd"
Sfx="*res://scripts/sfx.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]
theme/custom_font="res://assets/fonts/BarlowCondensed-SemiBold.ttf"

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.85, 0.66, 0.42, 1)
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=2

class_name I18n extends RefCounted
# Dil: kaynak metinler Türkçe, İngilizce karşılıklar burada. Label/Button metinleri
# TranslationServer üzerinden otomatik çevrilir; kod içinde T.s("...") kullanılır.

static var lang := "tr"
static var _tr: Translation

static func setup(l: String) -> void:
	lang = l
	if _tr == null:
		_tr = Translation.new()
		_tr.locale = "en"
		for k in EN:
			_tr.add_message(k, EN[k])
			var up: String = (k as String).to_upper()
			if up != k and not EN.has(up):
				_tr.add_message(up, (EN[k] as String).to_upper())
		TranslationServer.add_translation(_tr)
	TranslationServer.set_locale("en" if l == "en" else "tr")

static func s(t: String) -> String:
	if lang == "tr":
		return t
	if EN.has(t):
		return EN[t]
	return TranslationServer.translate(t)

static func default_lang() -> String:
	return "tr" if OS.get_locale_language() == "tr" else "en"

